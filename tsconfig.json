{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "jsx": "react-jsx",
      "baseUrl": ".",
      "paths": {
        "@/*": ["client/src/*"],
        "@shared/*": ["shared/*"]
      }
    },
    "include": [".", "client/src/**/*", "server/**/*", "shared/**/*"]
}